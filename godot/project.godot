; EXERSUITE3D — proyecto Godot 4 (kit de migración desde la app web).
; Motor: Godot 4.3+ (probado contra la API 4.3/4.4). Renderer móvil-amigable.

config_version=5

[application]

config/name="EXERSUITE3D"
config/description="Diseño y simulación 3D de máquinas de gimnasio (migración desde la app web)"
run/main_scene="res://main/Main.tscn"
config/features=PackedStringArray("4.3")
config/icon="res://extras/logo-mark.png"
boot_splash/bg_color=Color(0.0784314, 0.0862745, 0.105882, 1)
boot_splash/image="res://extras/logo-full.png"
boot_splash/fullsize=false

[display]

window/size/viewport_width=1280
window/size/viewport_height=800
; La UI se diseña a 1280x800 y se escala al tamaño/densidad de la pantalla
; real (canvas_items no reduce la resolución del render 3D).
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=6

[input]

simular={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":32,"physical_keycode":0,"key_label":0,"unicode":32,"location":0,"echo":false,"script":null)
]
}

[physics]

3d/default_gravity=9.81
common/physics_ticks_per_second=60

[rendering]

renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
; Obligatorio para exportar a Android (compresión de texturas móvil).
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=1
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=1
