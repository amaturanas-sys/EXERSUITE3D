{
  "name": "exersuite3d",
  "version": "0.2.100",
  "description": "EXERSUITE3D - Plataforma de diseno 3D y simulacion de fisicas para prototipar maquinas de gimnasio (Android + Windows).",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "android:add": "cap add android",
    "android:sync": "npm run build && cap sync android",
    "android:open": "cap open android",
    "android:apk": "npm run android:sync && cd android && ./gradlew assembleDebug",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build"
  },
  "dependencies": {
    "@capacitor/filesystem": "^6.0.4",
    "@capacitor/share": "^6.0.4",
    "@dimforge/rapier3d-compat": "^0.19.3",
    "@fontsource/dm-sans": "^5.3.0",
    "fflate": "^0.8.3",
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@capacitor/android": "^6.2.1",
    "@capacitor/cli": "^6.2.1",
    "@capacitor/core": "^6.2.1",
    "@tauri-apps/cli": "^2.11.4",
    "@types/three": "^0.169.0",
    "playwright-core": "^1.49.1",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  },
  "license": "UNLICENSED"
}
